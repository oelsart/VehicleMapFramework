<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>VehicleMapFramework</RootNamespace>
    <OutDir>$(ModDir)\1.7\_CombatExtended\Assemblies\</OutDir>
  </PropertyGroup>

  <PropertyGroup>
    <SteamWorkshopRoot Condition="'$(SteamWorkshopRoot)' == ''">..\..\..\..\..\..\workshop\content\294100</SteamWorkshopRoot>
  </PropertyGroup>
  <PropertyGroup>
    <VFUnstableFolder Condition="'$(CIBuild)' == 'true'">$(SteamWorkshopRoot)\3522907382</VFUnstableFolder>
    <VFUnstableFolder Condition="'$(CIBuild)' != 'true'">..\..\..\Vehicle-Framework</VFUnstableFolder>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="CombatExtended">
      <HintPath>$(SteamWorkshopRoot)\3495749827\Assemblies\CombatExtended.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)'=='Dev'">
    <Reference Include="SmashTools">
      <HintPath>$(VFUnstableFolder)\1.7\Assemblies\SmashTools.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Vehicles">
      <HintPath>$(VFUnstableFolder)\1.7\Assemblies\Vehicles.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)'=='Release'or'$(Configuration)'=='Debug'">
    <Reference Include="SmashTools">
      <HintPath>$(SteamWorkshopRoot)\3014915404\1.7\Assemblies\SmashTools.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Vehicles">
      <HintPath>$(SteamWorkshopRoot)\3014915404\1.7\Assemblies\Vehicles.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VehicleMapFramework\VehicleMapFramework.csproj">
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="GenerateEmptyUnityCoreModule"
          BeforeTargets="ResolveAssemblyReferences"
          Condition="!Exists('$(IntermediateOutputPath)UnityEngine.CoreModule.dll')">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(IntermediateOutputPath)empty.cs" Lines="" Overwrite="true" />
    <Csc Sources="$(IntermediateOutputPath)empty.cs"
         OutputAssembly="$(IntermediateOutputPath)UnityEngine.CoreModule.dll"
         TargetType="Library" />
  </Target>

  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(IntermediateOutputPath)UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>