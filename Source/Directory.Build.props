<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <FileVersion>1.7.0</FileVersion>
    <AssemblyVersion>1.7.0</AssemblyVersion>

    <Configurations>Debug;Dev;Release</Configurations>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Deterministic>true</Deterministic>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <FileAlignment>512</FileAlignment>
    <AppDesignerFolder>Properties</AppDesignerFolder>

    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <UseKrafsPackageRef>false</UseKrafsPackageRef>
	
	<implicitUsings>true</implicitUsings>

    <ModDir>$(MSBuildThisFileDirectory)\..\</ModDir>
    <RefDir>$(ModDir)..\..\</RefDir>
  </PropertyGroup>
  
  <PropertyGroup>
    <SteamWorkshopRoot Condition="'$(SteamWorkshopRoot)' == ''">E:\Program Files (x86)\Steam\steamapps\workshop\content\294100</SteamWorkshopRoot>
  </PropertyGroup>
  <PropertyGroup>
    <VFUnstableFolder Condition="'$(CIBuild)' == 'true'">$(SteamWorkshopRoot)\3522907382</VFUnstableFolder>
    <VFUnstableFolder Condition="'$(CIBuild)' != 'true'">..\..\..\Vehicle-Framework</VFUnstableFolder>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
    <DefineConstants>UNITY_ASSERTIONS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Dev|AnyCPU'">
    <Optimize>true</Optimize>
    <DefineConstants>UNITY_ASSERTIONS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseKrafsPackageRef)' == 'true'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseKrafsPackageRef)' != 'true' and '$(IndependentFromRuntime)' == ''">
    <Reference Include="System">
      <HintPath>$(RefDir)\System.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Xml">
      <HintPath>$(RefDir)\System.Xml.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Xml.Linq">
      <HintPath>$(RefDir)\System.Xml.Linq.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="mscorlib">
      <HintPath>$(RefDir)\mscorlib.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RefDir)\UnityStubs.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RefDir)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RefDir)\Waylith.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Waylith.UnityCompat">
      <HintPath>$(RefDir)\Waylith.UnityCompat.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>