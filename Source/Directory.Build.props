<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <FileVersion>1.7.0</FileVersion>
    <AssemblyVersion>1.7.0</AssemblyVersion>
    <AssemblyCopyright>Copyright ©OELS  2024-2026</AssemblyCopyright>

    <Configurations>Debug;Dev;Release</Configurations>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Deterministic>true</Deterministic>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <FileAlignment>512</FileAlignment>
    <AppDesignerFolder>Properties</AppDesignerFolder>

    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
	
	<implicitUsings>true</implicitUsings>

    <ModDir>$(MSBuildThisFileDirectory)\..\</ModDir>
    <RefDir>$(ModDir)..\..\</RefDir>
  </PropertyGroup>
  
  <PropertyGroup>
    <SteamWorkshopRoot Condition="'$(SteamWorkshopRoot)' == ''">E:\Program Files (x86)\Steam\steamapps\workshop\content\294100</SteamWorkshopRoot>
  </PropertyGroup>
  <PropertyGroup>
    <VFUnstableFolder Condition="'$(CIBuild)' == 'true'">$(SteamWorkshopRoot)\3522907382</VFUnstableFolder>
    <VFUnstableFolder Condition="'$(CIBuild)' != 'true'">..\..\..\Vehicle-Framework</VFUnstableFolder>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
    <DefineConstants>UNITY_ASSERTIONS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Dev|AnyCPU'">
    <Optimize>true</Optimize>
    <DefineConstants>UNITY_ASSERTIONS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>