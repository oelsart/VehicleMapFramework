<Project>
  <Target Name="CopyToDev"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Dev' and '$(SkipCopyToDev)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)CopyToDev.ps1&quot; -SolutionDir &quot;$(MSBuildThisFileDirectory)&quot;" />
  </Target>
</Project>