<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>VehicleMapFramework</RootNamespace>
    <AssemblyName>VehicleMapFramework</AssemblyName>
    <OutDir>$(ModDir)\1.7\Assemblies\</OutDir>
    <Configurations>Debug;Dev;Release;DevRelease</Configurations>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VMF_AchtungPatch" />
    <InternalsVisibleTo Include="VMF_CEPatch" />
    <InternalsVisibleTo Include="VMF_DBHCompat" />
    <InternalsVisibleTo Include="VMF_RimefellerCompat" />
    <InternalsVisibleTo Include="VMF_VEFCompat" />
    <InternalsVisibleTo Include="Test_VehicleMapFramework" />
    <InternalsVisibleTo Include="MapVehiclesOcean" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" />
    <PackageReference Include="Lib.Harmony" />
    <PackageReference Include="Nerdbank.GitVersioning">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  
  <ItemGroup Condition="'$(Configuration)'=='Dev'or'$(Configuration)'=='DevRelease'">
    <Reference Include="AnimationKit">
      <HintPath>$(VFUnstableFolder)\1.7\Assemblies\AnimationKit.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="CoreLib">
      <HintPath>$(VFUnstableFolder)\1.7\Assemblies\CoreLib.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SmashTools">
      <HintPath>$(VFUnstableFolder)\1.7\Assemblies\SmashTools.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Vehicles">
      <HintPath>$(VFUnstableFolder)\1.7\Assemblies\Vehicles.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)'=='Release'or'$(Configuration)'=='Debug'">
    <Reference Include="SmashTools">
      <HintPath>$(SteamWorkshopRoot)\3014915404\1.7\Assemblies\SmashTools.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Vehicles">
      <HintPath>$(SteamWorkshopRoot)\3014915404\1.7\Assemblies\Vehicles.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\Directory.Build.props">
      <Link>Directory.Build.props</Link>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <AboutFolderPath Condition="'$(AboutXmlPath)' == ''">../../About</AboutFolderPath>
    <AboutFolderPath Condition="'$(Configuration)'=='Dev'or'$(Configuration)'=='DevRelease'">../../Dev/About</AboutFolderPath>
  </PropertyGroup>
  <Target Name="UpdateVersion" AfterTargets="PostBuildEvent" Condition="'$(SkipPostBuild)' != 'true'">
    <Exec Command="powershell.exe -ExecutionPolicy Bypass -File &quot;$(ProjectDir)UpdateAboutXmlVersion.ps1&quot; -AboutXmlPath &quot;$(AboutFolderPath)/About.xml&quot; -BuiltDllPath &quot;$(TargetPath)&quot;"/>
  </Target>

  <!-- Manual Patches -->
  <ItemGroup>
    <ProjectReference Include="..\..\ManualHarmony\ManualHarmony.Runtime\ManualHarmony.Runtime.csproj" />
    <ProjectReference
      Include="..\..\ManualHarmony\ManualHarmony\ManualHarmony.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
    <CompilerVisibleProperty Include="ManualHarmony_GeneratedNamespace" />
    <CompilerVisibleProperty Include="ManualHarmony_GeneratedClassName" />
  </ItemGroup>
  <PropertyGroup>
    <ManualHarmony_GeneratedNamespace>VehicleMapFramework.VMF_HarmonyPatches</ManualHarmony_GeneratedNamespace>
    <ManualHarmony_GeneratedClassName>ManualPatches_VMF</ManualHarmony_GeneratedClassName>
    <CompilerGeneratedFilesOutputPath>$(IntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

</Project>