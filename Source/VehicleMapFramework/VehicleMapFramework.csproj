<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>VehicleMapFramework</RootNamespace>
    <AssemblyName>VehicleMapFramework</AssemblyName>
    <OutDir>$(ModDir)\1.7\Assemblies\</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony.Ref"/>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="BannedSymbols.txt"/>
    <PackageReference Include="Nerdbank.GitVersioning">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PolySharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)'=='Dev'">
    <Reference Include="AnimationKit">
      <HintPath>$(VFUnstableFolder)\1.7\Assemblies\AnimationKit.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="CoreLib">
      <HintPath>$(VFUnstableFolder)\1.7\Assemblies\CoreLib.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SmashTools">
      <HintPath>$(VFUnstableFolder)\1.7\Assemblies\SmashTools.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Vehicles">
      <HintPath>$(VFUnstableFolder)\1.7\Assemblies\Vehicles.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)'=='Release'or'$(Configuration)'=='Debug'">
    <Reference Include="SmashTools">
      <HintPath>$(SteamWorkshopRoot)\3014915404\1.7\Assemblies\SmashTools.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Vehicles">
      <HintPath>$(SteamWorkshopRoot)\3014915404\1.7\Assemblies\Vehicles.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Update="System.Drawing">
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Update="System.IO.Compression.FileSystem">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <AboutFolderPath Condition="'$(AboutXmlPath)' == ''">../../About</AboutFolderPath>
    <AboutFolderPath Condition="'$(Configuration)'=='Dev'">../../Dev/About</AboutFolderPath>
  </PropertyGroup>
  <Target Name="UpdateVersion" AfterTargets="PostBuildEvent" Condition="'$(SkipPostBuild)' != 'true'">
    <Exec Command="powershell.exe -ExecutionPolicy Bypass -File &quot;$(ProjectDir)UpdateAboutXmlVersion.ps1&quot; -AboutXmlPath &quot;$(AboutFolderPath)/About.xml&quot; -BuiltDllPath &quot;$(TargetPath)&quot;"/>
  </Target>
  <Target Name="CopyToDev" AfterTargets="PostBuildEvent" Condition="'$(Configuration)'=='Dev'">
    <Exec Command="(robocopy ../../1.5 ../../../VehicleMapFrameworkDev/1.5 /MIR /E) ^&amp; IF %ERRORLEVEL% LEQ 1 exit 0"/>
    <Exec Command="(robocopy ../../1.6 ../../../VehicleMapFrameworkDev/1.6 /MIR /E /XD AssetBundles) ^&amp; IF %ERRORLEVEL% LEQ 1 exit 0"/>
    <Exec Command="(robocopy ../../1.7 ../../../VehicleMapFrameworkDev/1.7 /MIR /E /XD AssetBundles) ^&amp; IF %ERRORLEVEL% LEQ 1 exit 0"/>
    <Exec Command="(robocopy ../../Common ../../../VehicleMapFrameworkDev/Common /MIR /E) ^&amp; IF %ERRORLEVEL% LEQ 1 exit 0"/>
    <Exec Command="(robocopy ../../Dev/About ../../../VehicleMapFrameworkDev/About /MIR /E) ^&amp; IF %ERRORLEVEL% LEQ 1 exit 0"/>
    <Exec Command="(robocopy ../../Dev/AssetBundles ../../../VehicleMapFrameworkDev/2022.3/AssetBundles /MIR /E) ^&amp; IF %ERRORLEVEL% LEQ 1 exit 0" />
    <Exec Command="(robocopy ../../Dev/ ../../../VehicleMapFrameworkDev LoadFolders.xml) ^&amp; IF %ERRORLEVEL% LEQ 1 exit 0"/>
    <Exec Command="(robocopy ../../ ../../../VehicleMapFrameworkDev LICENSE) ^&amp; IF %ERRORLEVEL% LEQ 1 exit 0"/>
  </Target>
</Project>