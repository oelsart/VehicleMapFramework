<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>VehicleMapFramework.Test_CompatPatches</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JunitXml.TestLogger" Version="8.0.0" />
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="NUnitLite" Version="4.6.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework"/>
  </ItemGroup>

  <PropertyGroup>
    <SteamWorkshopRoot Condition="'$(SteamWorkshopRoot)' == ''">E:\Program Files (x86)\Steam\steamapps\workshop\content\294100</SteamWorkshopRoot>
    <IndependentFromRuntime>true</IndependentFromRuntime>
  </PropertyGroup>

  <Target Name="GenerateConstants" BeforeTargets="BeforeBuild">
    <WriteLinesToFile File="HarmonyPatches/GeneratedConstants.cs" Lines="internal static class BuildConstants { public const string SteamWorkshopRoot = @&quot;$(SteamWorkshopRoot)&quot;%3B }" Overwrite="true"/>
  </Target>
</Project>
