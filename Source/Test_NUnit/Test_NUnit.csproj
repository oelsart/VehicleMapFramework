<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>VehicleMapFramework.Test</RootNamespace>
    <GenerateDependencyFile>true</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Mono.Cecil" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <Target Name="GenerateConstants" BeforeTargets="BeforeBuild">
    <WriteLinesToFile File="HarmonyPatches/GeneratedConstants.cs" Lines="internal static class BuildConstants { public const string SteamWorkshopRoot = @&quot;$(SteamWorkshopRoot)&quot;%3B }" Overwrite="true"/>
  </Target>
</Project>
