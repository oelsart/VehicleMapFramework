  <RunConfiguration>
    <TestAdaptersPaths>E:\Program Files (x86)\Steam\steamapps\common\RimWorld\Mods\Vehicle-Framework\1.7\Assemblies</TestAdaptersPaths>
  </RunConfiguration>
</RunSettings>