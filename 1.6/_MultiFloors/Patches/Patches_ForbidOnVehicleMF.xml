<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>Defs/ThingDef[
      modExtensions/li[
      @Class="MultiFloors.StairsModExtension" and
      not(stairsSettings/isUpstairs[text()="true"])
      ]
      ]/placeWorkers
    </xpath>
    <value>
      <li>VehicleMapFramework.PlaceWorker_ForbidOnVehicle</li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[
      not(placeWorkers) and
      modExtensions/li[
      @Class="MultiFloors.StairsModExtension" and
      not(stairsSettings/isUpstairs[text()="true"])
      ]
      ]
    </xpath>
    <value>
      <placeWorkers>
        <li>VehicleMapFramework.PlaceWorker_ForbidOnVehicle</li>
      </placeWorkers>
    </value>
  </Operation>
</Patch>