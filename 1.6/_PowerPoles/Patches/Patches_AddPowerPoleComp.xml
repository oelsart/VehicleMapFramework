            thingClass="RimForge.Buildings.Building_PowerPole" or
            thingClass="RimForge.Buildings.Building_WallConnector"
            ]/comps/li[@Class="CompProperties_Power"]/compClass[text()="CompPowerTransmitter"]</xpath>
